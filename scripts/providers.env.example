# Шаблон ~/.claude/providers.env  (права 600, НІКОЛИ не додавай у git чи workspace.json)
# Заповнює `bash install.sh --profiles` (ключ вводиться у прихованому полі). Можна й вручну: рядок KEY=значення без лапок.

# DeepSeek: https://platform.deepseek.com → API keys  (профілі claude-ds, claude-ds-fast)
DEEPSEEK_API_KEY=

# Kimi / Moonshot: https://platform.moonshot.ai → API keys  (профіль claude-kimi)
KIMI_API_KEY=

# Локальний роутер freellmapi / LiteLLM / claude-code-router  (профіль claude-free, експериментальний)
FREELLM_BASE_URL=http://localhost:3001
FREELLM_API_KEY=local
# Назва моделі, яку розуміє твій роутер (однакова для всіх слотів)
FREELLM_MODEL=auto
